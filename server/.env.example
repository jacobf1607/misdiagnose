# ===========================================
# MISDIAGNOSE SERVER - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# AI Provider Configuration
# Options: 'hybrid' (recommended), 'groq', 'openai', 'claude'
# hybrid = Groq for real-time tasks, OpenAI for quality tasks
AI_PROVIDER=hybrid

# Anthropic API Key (for Claude - fallback/alternative)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Groq API Key (for ultra-fast inference)
# Get yours at: https://console.groq.com
GROQ_API_KEY=gsk_your-key-here

# OpenAI API Key (for high-quality generation)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Server Configuration
PORT=3005
NODE_ENV=production

# RAG Service URL (internal Railway URL in production)
RAG_API_URL=http://localhost:3006

# Background case generation (set to 'true' to auto-generate cases)
ENABLE_BACKGROUND_GENERATION=true

# Frontend URL (for CORS - set to your Railway frontend URL)
FRONTEND_URL=https://your-frontend.up.railway.app
